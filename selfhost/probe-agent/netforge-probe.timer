# root/selfhost/probe-agent/netforge-probe.timer
# Adjust OnUnitActiveSec to match the enrolled interval (default: 300 s).
[Unit]
Description=Schedule authorized NetForge subscriber-side probe

[Timer]
OnBootSec=30s
OnUnitActiveSec=300s
AccuracySec=5s
Unit=netforge-probe.service

[Install]
WantedBy=timers.target
