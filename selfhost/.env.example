# root/selfhost/.env.example
# Copy to .env and replace every value with freshly generated credentials.
# Values used by the FreeRADIUS config generator permit A-Z a-z 0-9 _ . -
POSTGRES_USER=netforge
POSTGRES_DB=netforge
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_CHARACTER_PASSWORD
NETFORGE_ADMIN_USER=admin
NETFORGE_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_UNIQUE_ADMIN_PASSWORD
NETFORGE_HTTP_PORT=8080
# Bind only to the private IP assigned to the host and firewall UDP 1812/1813.
RADIUS_BIND_IP=0.0.0.0

# Optional included TLS proxy: docker compose --profile https up -d --build
NETFORGE_DOMAIN=netforge.localhost
NETFORGE_HTTPS_PORT=8443
NETFORGE_HTTPS_BIND_IP=127.0.0.1

# Notification delivery is entirely opt-in via the CRM admin settings.
# Email requires a STARTTLS SMTP service (normally TCP 587, NOT implicit TLS 465).
NETFORGE_SMTP_HOST=
NETFORGE_SMTP_PORT=587
NETFORGE_SMTP_FROM=
NETFORGE_SMTP_USER=
NETFORGE_SMTP_PASSWORD=
NETFORGE_OPERATIONS_EMAIL=

# Optional operational Telegram alert destination. Bot tokens are secrets.
NETFORGE_TELEGRAM_BOT_TOKEN=
NETFORGE_OPERATIONS_TELEGRAM_CHAT_ID=

# The API Docker image supplies /usr/bin/snmpget. Override only when the
# application runs natively with a trusted Net-SNMP executable.
# NETFORGE_SNMPGET_PATH=/usr/bin/snmpget

# RouterOS REST inspection is denied unless explicit management subnets are configured.
NETFORGE_ROUTEROS_ALLOWED_CIDRS=
